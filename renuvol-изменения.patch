diff -ruN a/src/styles/refinements.css b/src/styles/refinements.css
--- a/src/styles/refinements.css	2026-09-07 19:54:02.571585943 +0800
+++ b/src/styles/refinements.css	2026-09-07 19:54:03.136635843 +0800
@@ -499,3 +499,54 @@
     transform .26s var(--rv-ease),
     opacity calc(var(--rv-dur) * .8) var(--rv-ease);
 }
+
+/*
+  Стеклянные карточки глав в рельсе «Что меняется в коже».
+
+  Панель proof занимает весь экран и полупрозрачна — сквозь неё виден рельс,
+  и карточки читаются как стекло. backdrop-filter дорогой, поэтому на
+  сенсорных устройствах (hover: none) он отключён, а непрозрачность
+  поднята: на телефоне панель всё равно перекрывает карточку целиком.
+*/
+.rv-chapter {
+  padding: var(--rv-4) var(--rv-5);
+  border-radius: 20px;
+  background: linear-gradient(
+    165deg,
+    rgb(255 255 255 / .55),
+    rgb(255 255 255 / .22) 55%,
+    rgb(255 255 255 / .38)
+  );
+  -webkit-backdrop-filter: blur(16px) saturate(1.5);
+  backdrop-filter: blur(16px) saturate(1.5);
+  border: 1px solid rgb(255 255 255 / .6);
+  /* Внутренний блик по верхней кромке — то, что отличает стекло от плашки. */
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / .65);
+  transition:
+    transform var(--rv-dur) var(--rv-ease),
+    border-color var(--rv-dur) var(--rv-ease);
+}
+
+/* Кнопка-хит накрывает карточку целиком — скругление повторяем и ей. */
+.rv-chapter__hit { border-radius: 20px; }
+
+@media (hover: hover) and (pointer: fine) {
+  .rv-chapter:hover {
+    transform: translateY(-4px);
+    border-color: color-mix(in srgb, var(--rv-chapter-accent) 45%, rgb(255 255 255 / .6));
+  }
+}
+
+/* Тач-устройства: без блюра, плотнее — производительность важнее эффекта. */
+@media (hover: none) {
+  .rv-chapter {
+    background: linear-gradient(
+      165deg,
+      rgb(255 255 255 / .78),
+      rgb(255 255 255 / .62) 55%,
+      rgb(255 255 255 / .72)
+    );
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
